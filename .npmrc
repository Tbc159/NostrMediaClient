# Nuxt e Vite risolvono meglio con le dipendenze non appiattite: teniamo
# l'isolamento di pnpm, cosi' una dipendenza non dichiarata fallisce subito
# invece di funzionare per caso grazie all'hoisting.
node-linker=isolated
strict-peer-dependencies=false
auto-install-peers=true

# Blocca l'installazione se la versione di Node non soddisfa "engines".
engine-strict=true
