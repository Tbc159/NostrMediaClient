node_modules/
# Senza slash: `nuxt generate` lascia un symlink `dist` verso .output/public, e
# `dist/` con lo slash vale solo per le cartelle. Un symlink assoluto committato
# punterebbe al disco di chi ha fatto la build.
dist
.output/
.nuxt/
.nitro/
.cache/
coverage/
*.tsbuildinfo

# Ambiente: i puntamenti privati a relay e server Blossom non vanno versionati.
# Solo .env.example sta nel repo.
.env
.env.*
!.env.example

# Playwright
test-results/
playwright-report/
blob-report/
.playwright/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log
npm-debug.log*
pnpm-debug.log*

# Stato del dev server gestito da scripts/client.sh
.run/
