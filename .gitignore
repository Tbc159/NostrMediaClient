node_modules/
# No slash: `nuxt generate` leaves a `dist` symlink to .output/public, and
# `dist/` with the slash matches directories only. A committed absolute symlink
# would point at the disk of whoever ran the build.
dist
.output/
.nuxt/
.nitro/
.cache/
coverage/
*.tsbuildinfo

# Environment: private pointers to relays and Blossom servers must not be
# versioned. Only .env.example is in the repo.
.env
.env.*
!.env.example

# Playwright
test-results/
playwright-report/
blob-report/
.playwright/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.log
npm-debug.log*
pnpm-debug.log*

# State of the dev server managed by scripts/client.sh
.run/
