# Copy to .env and fill in. The .env file must NOT be versioned: private
# pointers to relays and Blossom servers stay out of the repository.
#
# All these values are only FIRST-RUN DEFAULTS. The user can replace them from
# the client's settings, and their choice is then synchronised on the relays via
# kind 10002 (NIP-65) and 10063 (Blossom BUD-03).
# The client must stay fully working when pointed elsewhere.

# --- Relay ------------------------------------------------------------------
# Comma-separated lists, the wss:// scheme is mandatory.
# Relays to read from at start-up, before the user's relay list is known.
NUXT_PUBLIC_DEFAULT_READ_RELAYS="wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net"

# Relays to publish to by default.
NUXT_PUBLIC_DEFAULT_WRITE_RELAYS="wss://relay.damus.io,wss://nos.lol"

# Relays used only to resolve other people's profiles and relay lists (outbox model).
NUXT_PUBLIC_INDEXER_RELAYS="wss://purplepag.es,wss://user.kindpag.es"

# A private relay to keep the long-form drafts on (kind 30024).
# Drafts must NEVER end up on public relays. When empty, the "save draft"
# feature stays disabled in the UI instead of falling back on a public relay.
NUXT_PUBLIC_DRAFT_RELAY=""

# --- Blossom (media) --------------------------------------------------------
# Servers to upload media to, in order of preference. The first is the
# primary, the others receive the mirroring (BUD-04).
#
# Verified from the browser (see docs/PROGRESS.md). A non-obvious requirement:
# the server must send Access-Control-Allow-Origin on the ACTUAL response and
# not only on the OPTIONS preflight, otherwise the browser blocks the request.
# Access-Control-Expose-Headers on x-reason is needed too: it is the only way to
# read from JavaScript why an upload was refused.
NUXT_PUBLIC_DEFAULT_BLOSSOM_SERVERS="https://blossom.yakihonne.com,https://nostr.download"

# --- Application ------------------------------------------------------------
# The client's public URL: it builds the canonical links and the Open Graph
# meta tags of the SSR routes.
NUXT_PUBLIC_SITE_URL="http://localhost:3000"

# A public gateway used for the share links towards third-party clients.
NUXT_PUBLIC_NJUMP_URL="https://njump.me"

# --- Processing service (Audio section) -------------------------------------
# It is not Nostr: it is an external HTTP microservice; the archive and the
# audio processing are its domains. Here is the first-run default, replaceable
# from the client's settings.
# Without /v0: the client adds it.
NUXT_PUBLIC_MEDIA_MANAGER_URL="https://mediamanager-dev.duckdns.org"

# The media-manager's key, sent as X-API-Key.
# WARNING: it is a NUXT_PUBLIC_ variable, so it ends up in the bundle served to
# the browser. Fill it in for local development only; a published build must
# stay without it, and whoever uses it enters it from the settings.
NUXT_PUBLIC_MEDIA_MANAGER_API_KEY=""

# The feed's stable address on a domain NMC manages (CNAME and managed
# subdomains). Off until the NMC domain exists: the interface shows them as
# "coming soon" and only simulates them. Turning it on is not enough by itself:
# the service has to declare them in GET /v0/feed/domini/capacita too.
NUXT_PUBLIC_FEED_DOMINI_GESTITI="false"
# The managed subdomains' suffix: <name>.<suffix>. A placeholder for now.
NUXT_PUBLIC_FEED_SUBDOMAIN_SUFFIX="duckdns.org"
