# Copiare in .env e valorizzare. Il file .env NON va versionato:
# i puntamenti privati a relay e server Blossom restano fuori dal repository.
#
# Tutti questi valori sono soltanto DEFAULT di primo avvio. L'utente puo'
# sostituirli dalle impostazioni del client, e la sua scelta viene poi
# sincronizzata sui relay via kind 10002 (NIP-65) e 10063 (Blossom BUD-03).
# Il client deve restare pienamente funzionante puntando altrove.

# --- Relay ------------------------------------------------------------------
# Liste separate da virgola, schema wss:// obbligatorio.
# Relay da cui leggere all'avvio, prima di conoscere la relay list dell'utente.
NUXT_PUBLIC_DEFAULT_READ_RELAYS="wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net"

# Relay su cui pubblicare per default.
NUXT_PUBLIC_DEFAULT_WRITE_RELAYS="wss://relay.damus.io,wss://nos.lol"

# Relay usati solo per risolvere profili e relay list altrui (outbox model).
NUXT_PUBLIC_INDEXER_RELAYS="wss://purplepag.es,wss://user.kindpag.es"

# Relay privato su cui tenere le bozze long-form (kind 30024).
# Le bozze NON devono mai finire su relay pubblici. Se vuoto, la funzione
# "salva bozza" resta disabilitata in UI invece di ripiegare su un relay pubblico.
NUXT_PUBLIC_DRAFT_RELAY=""

# --- Blossom (media) --------------------------------------------------------
# Server su cui caricare i media, in ordine di preferenza. Il primo e' il
# primario, gli altri ricevono il mirroring (BUD-04).
#
# Verificati dal browser (vedi docs/PROGRESS.md). Requisito non ovvio: il
# server deve mandare Access-Control-Allow-Origin sulla risposta EFFETTIVA e
# non solo sul preflight OPTIONS, altrimenti il browser blocca la richiesta.
# Serve inoltre Access-Control-Expose-Headers su x-reason, che e' l'unico modo
# per leggere da JavaScript il motivo di un upload rifiutato.
NUXT_PUBLIC_DEFAULT_BLOSSOM_SERVERS="https://blossom.yakihonne.com,https://nostr.download"

# --- Applicazione -----------------------------------------------------------
# URL pubblico del client: serve a costruire i link canonici e i meta tag
# Open Graph delle route SSR.
NUXT_PUBLIC_SITE_URL="http://localhost:3000"

# Gateway pubblico usato per i link di condivisione verso client terzi.
NUXT_PUBLIC_NJUMP_URL="https://njump.me"
