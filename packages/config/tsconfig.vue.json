{
  "$schema": "https://json.schemastore.org/tsconfig",
  // The preset for the packages that contain Vue SFCs.
  // No "types": ["vite/client"]: these are library packages, not apps, and they
  // do not have Vite among their dependencies. The DOM lib comes from
  // tsconfig.base.json.
  "extends": "./tsconfig.lib.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "vue"
  },
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
